// ============================================================
// H-Sport — Prisma Schema (PostgreSQL via Supabase)
// Source of truth untuk tabel BISNIS + profiles.
// Supabase Auth tetap menangani auth.users (di luar schema ini).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// === 0. PROFIL USER (terhubung ke auth.users Supabase) ===
model Profile {
  id           String   @id @db.Uuid
  email        String   @unique
  fullName     String?  @map("full_name")
  avatarUrl    String?  @map("avatar_url")
  businessName String?  @map("business_name")
  phone        String?
  role         String   @default("staff")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
}

// === 1. MASTER KAIN ===
model Fabric {
  id           String  @id @default(cuid())
  name         String
  unit         String  @default("kg")
  reorderPoint Float   @default(5) @map("reorder_point")
  isActive     Boolean @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  batches  FabricBatch[]
  bomItems BomItem[]

  @@map("fabrics")
}

// === 2. PEMBELIAN KAIN PER BATCH (FIFO) ===
model FabricBatch {
  id            String   @id @default(cuid())
  fabricId      String   @map("fabric_id")
  supplierName  String   @map("supplier_name")
  purchaseDate  DateTime @map("purchase_date") @db.Date
  qtyPurchased  Float    @map("qty_purchased")
  qtyRemaining  Float    @map("qty_remaining")
  pricePerKg    Float    @map("price_per_kg")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  fabric Fabric      @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  usages BatchUsage[]

  @@index([fabricId])
  @@map("fabric_batches")
}

// === 3. ORDER ===
model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique @map("order_number")
  customerName    String   @map("customer_name")
  customerContact String?  @map("customer_contact")
  qtyItems        Int      @map("qty_items")
  specification   String?
  status          String   @default("draft")
  orderDate       DateTime @map("order_date") @db.Date
  deadline        DateTime? @db.Date
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  bomItems  BomItem[]
  timelines ProductionTimeline[]
  costing   OrderCosting?

  @@map("orders")
}

// === 4. BOM (KOMPOSISI BAHAN PER ORDER) ===
model BomItem {
  id             String   @id @default(cuid())
  orderId        String   @map("order_id")
  fabricId       String   @map("fabric_id")
  fabricName     String   @map("fabric_name")
  qtyRequired    Float    @map("qty_required")
  wastePct       Float    @default(0) @map("waste_percentage")
  qtyActual      Float    @map("qty_actual")
  pricePerKg     Float    @map("price_per_kg")
  materialCost   Float    @map("material_cost")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fabric Fabric @relation(fields: [fabricId], references: [id])

  @@index([orderId])
  @@index([fabricId])
  @@map("bom_items")
}

// === 5. TIMELINE PRODUKSI ===
model ProductionTimeline {
  id           String   @id @default(cuid())
  orderId      String   @map("order_id")
  stageName    String   @map("stage_name")
  status       String   @default("not_started")
  estimatedHrs Float?   @map("estimated_hrs")
  actualStart  DateTime? @map("actual_start") @db.Timestamptz(6)
  actualEnd    DateTime? @map("actual_end") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("production_timelines")
}

// === 6. COSTING PER ORDER ===
model OrderCosting {
  id            String  @id @default(cuid())
  orderId       String  @unique @map("order_id")
  materialCost  Float   @map("material_cost")
  laborCost     Float   @map("labor_cost")
  hpp           Float
  pricingMethod String  @default("markup") @map("pricing_method")
  markupPct     Float?  @map("markup_pct")
  fixedProfit   Float?  @default(0) @map("fixed_profit")
  sellingPrice  Float   @map("selling_price")
  shippingCost  Float   @default(0) @map("shipping_cost")
  profit        Float
  profitMargin  Float   @map("profit_margin")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_costing")
}

// === 7. PEMAKAIAN STOK PER BATCH (FIFO deduction) ===
model BatchUsage {
  id        String   @id @default(cuid())
  batchId   String   @map("batch_id")
  orderId   String   @map("order_id")
  qtyUsed   Float    @map("qty_used")
  usageDate DateTime @default(now()) @map("usage_date") @db.Timestamptz(6)

  batch FabricBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([orderId])
  @@map("batch_usage")
}

// === 8. RINGKASAN BULANAN (precompute untuk dashboard/laporan) ===
model MonthlySummary {
  id          String   @id @default(cuid())
  month       String   @unique // "2026-08"
  totalOrders Int      @map("total_orders")
  totalRevenue Float   @map("total_revenue")
  totalHpp    Float    @map("total_hpp")
  totalProfit Float    @map("total_profit")
  avgMargin   Float    @map("avg_margin")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("monthly_summaries")
}
